# Copy to .env and fill in. In Supabase: Project Settings > Database > Connection string.
# Use the "Session pooler" URI (works on IPv4 hosts). Keep this file private.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PORT=3000
